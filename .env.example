# Copiar a .env y completar
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/spotify_wrapped

# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
# En el navegador la sesión dura lo que dura este JWT. Para probar el vencimiento: 1m
JWT_ACCESS_TTL=2h
REFRESH_TTL_DIAS=7
BCRYPT_ROUNDS=12

# SameSite de la cookie de sesión: strict | lax | none.
# strict sirve con front y back en el mismo sitio. Con dominios distintos en producción: none.
# El flag Secure se activa solo con NODE_ENV=production o con none.
COOKIE_SAMESITE=strict

# Orígenes permitidos del front, separados por coma
CORS_ORIGIN=http://localhost:5173

# API key gratuita: https://www.last.fm/api/account/create
# Sin esto, la importación de Spotify funciona igual; solo se deshabilitan Last.fm y los géneros.
LASTFM_API_KEY=

MAX_UPLOAD_MB=20
