# Copiar a .env y completar
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/spotify_wrapped

# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TTL_DIAS=7
BCRYPT_ROUNDS=12

# Orígenes permitidos del front, separados por coma
CORS_ORIGIN=http://localhost:5173

# API key gratuita: https://www.last.fm/api/account/create
# Sin esto, la importación de Spotify funciona igual; solo se deshabilitan Last.fm y los géneros.
LASTFM_API_KEY=

MAX_UPLOAD_MB=20
